{
  "name": "bb-plugin-files-editor",
  "version": "0.2.0",
  "description": "Edit workspace files in BB with Monaco, a Pierre file tree, project search, and conflict diffs.",
  "type": "module",
  "engines": {
    "bb": ">=0.45.0",
    "bbPluginSdk": ">=0.6.15"
  },
  "bb": {
    "name": "Files",
    "description": "Edit workspace files in BB with Monaco, a Pierre file tree, project search, and conflict diffs.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "build:editor": "bun run scripts/build-editor.ts",
    "build": "bun run build:editor && bb plugin build"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@pierre/trees": "1.0.0-beta.6",
    "diff": "^9.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.15",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "hono": "^4.11.9",
    "jsdom": "^26.1.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "homepage": "https://github.com/brock6g/bb-plugins/tree/main/plugins/files-editor#readme",
  "bugs": {
    "url": "https://github.com/brock6g/bb-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brock6g/bb-plugins.git",
    "directory": "plugins/files-editor"
  },
  "keywords": [
    "bb-plugin",
    "files",
    "file-explorer",
    "grep",
    "full-text-search",
    "search-in-files",
    "file-browser",
    "file-tree",
    "editor",
    "code-editor",
    "text-editor",
    "syntax-highlighting",
    "find-in-file",
    "vscode",
    "workspace"
  ],
  "files": [
    "assets",
    "docs",
    "dist",
    "server.ts",
    "app.tsx",
    "components",
    "lib",
    "skills",
    "README.md",
    "LICENSE",
    "scripts",
    "editor-bundle"
  ]
}
